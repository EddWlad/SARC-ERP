[Unit]
Description=SARC: latidos del VPS y del servicio
After=network-online.target

[Service]
Type=oneshot
# root: leen /etc/sarc/sarc.env (y, la del certificado, /etc/letsencrypt). No escriben en disco.
User=root
ExecStart=/usr/local/sbin/sarc-heartbeat
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
