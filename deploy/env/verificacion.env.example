# Plantilla de /etc/sarc/verificacion.env. Sin valores reales: el repositorio es público.
# Se rellena tras crear la cuenta de verificación; 0600, solo la cuenta que ejecuta `sarc-deploy`;
# `sarc.service` nunca lo carga. La credencial no se guarda en GitHub ni en el manifiesto.
SARC_VERIFY_USER=<definir>
SARC_VERIFY_PASSWORD=<definir>
