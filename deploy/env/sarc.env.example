# Plantilla de /etc/sarc/sarc.env (0640 root:sarc). Sin valores reales: el repositorio es público.
# Copiar al VPS como /etc/sarc/sarc.env y reemplazar cada <definir> con el valor real.
# El inventario completo está en docs/operacion/inventario-variables.md.

# --- Aplicación ---
SPRING_PROFILES_ACTIVE=prod

# --- Base de datos (PostgreSQL 18 en Docker, solo 127.0.0.1) ---
SARC_DB_URL=jdbc:postgresql://127.0.0.1:5432/sarc
# Fijo y no secreto: debe coincidir con deploy/compose/compose.prod.yaml.
SARC_DB_USER=sarc
SARC_DB_PASSWORD=<definir>
# Contraseña con la que el contenedor crea el usuario de la base (compose la interpola desde este archivo; debe ser igual a SARC_DB_PASSWORD).
POSTGRES_PASSWORD=<definir>

# --- Cloudinary (carpeta y clave propias de producción; obligatorias en el perfil prod) ---
CLOUDINARY_CLOUD_NAME=<definir>
CLOUDINARY_API_KEY=<definir>
CLOUDINARY_API_SECRET=<definir>
SARC_STORAGE_CLOUDINARY_ROOT_FOLDER=sarc-prod

# --- Entorno de despliegue ---
# `ensayo` solo en la VM de ensayo (permite una CA de prueba para el certificado); en producción, `produccion`.
SARC_DEPLOY_ENV=produccion
# Repositorio público donde el flujo de versión candidata publica los artefactos (propietario/repositorio).
SARC_GITHUB_REPO=<definir>

# --- Direccion publica (IP del VPS; no es un secreto). La usan la comprobacion del certificado y Nginx ---
SARC_PUBLIC_IP=<definir>

# --- Reporte de verificación ---
# Se define tras la primera instalación, con el identificador del reporte de verificación emitido en SARC.
SARC_VERIFY_REPORT_ID=<definir>

# --- Administrador inicial ---
# Solo primer arranque; borrar ambas variables y reiniciar el servicio después de cambiar la clave.
SARC_BOOTSTRAP_ADMIN_EMAIL=<definir>
SARC_BOOTSTRAP_ADMIN_PASSWORD=<definir>

# --- Latidos de Healthchecks.io (una URL por comprobación; son secretos) ---
HC_URL_VPS_LATIDO=<definir>
HC_URL_SERVICIO=<definir>
HC_URL_COPIA_NOCTURNA=<definir>
HC_URL_CERTIFICADO=<definir>
HC_URL_DISCO=<definir>
# Las URL de `publicacion` y `sonda` viven como secretos del entorno `production` de GitHub;
# la de `descarga-local`, en el computador local.
