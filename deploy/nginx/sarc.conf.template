# Plantilla de Nginx para SARC. Marcador: <IP_PUBLICA> (IP del VPS; ver docs/operacion/certificado.md).
# Se renderiza con:  sed 's/<IP_PUBLICA>/<la IP real>/g' sarc.conf.template > /etc/nginx/conf.d/sarc.conf
# Sin valores reales. Instalar tambien deploy/nginx/maintenance.html en /opt/sarc/maintenance/.
#
# Reglas (plan §2, contracts/health-and-alerts.md):
#   - 80: solo el desafio ACME de Certbot y redireccion 301 a HTTPS.
#   - 443: TLS (Let's Encrypt para IP), HSTS sin includeSubDomains, estaticos de Angular, proxy /api/ a 127.0.0.1:8080.
#   - /actuator/: solo readiness (UP/DOWN sin detalles); todo lo demas responde 404.
#   - Mantenimiento: si existe /var/lib/sarc/maintenance.flag, todo responde 503 con maintenance.html.
#   - Registros sin Cookie, Authorization ni parametros de consulta.

# Limite de peticiones al ingreso (ADR 0001): ritmo sostenido bajo, con margen para uso normal.
limit_req_zone $binary_remote_addr zone=sarc_login:10m rate=10r/m;

# Formato de registro minimo: no incluye cabeceras Cookie/Authorization ni la cadena de consulta ($uri, no $request).
log_format sarc '$remote_addr [$time_iso8601] "$request_method $uri" $status $body_bytes_sent "$http_user_agent"';

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    access_log /var/log/nginx/sarc-access.log sarc;

    # Desafio HTTP-01 de Certbot (modo webroot).
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    http2 on;
    server_name <IP_PUBLICA>;

    access_log /var/log/nginx/sarc-access.log sarc;
    error_log /var/log/nginx/sarc-error.log warn;

    ssl_certificate     /etc/letsencrypt/live/<IP_PUBLICA>/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/<IP_PUBLICA>/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:sarc_tls:10m;
    ssl_session_tickets off;

    # Cabeceras de seguridad. HSTS sin includeSubDomains (no hay dominio).
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # Cuerpo maximo acorde a la aplicacion (originales de importacion de 20 MiB; peticion de 21 MiB).
    client_max_body_size 21m;
    server_tokens off;

    # Mantenimiento: lo activa y lo retira sarc-deploy creando o borrando el archivo indicador.
    error_page 503 @mantenimiento;
    if (-f /var/lib/sarc/maintenance.flag) {
        return 503;
    }
    location @mantenimiento {
        root /opt/sarc/maintenance;
        rewrite ^ /maintenance.html break;
        add_header Cache-Control "no-store" always;
        add_header Retry-After "300" always;
    }

    # Salud publica: solo readiness. Liveness y el resto, solo desde 127.0.0.1 (no pasan por Nginx).
    location = /actuator/health/readiness {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location /actuator/ {
        return 404;
    }
    location ~ ^/(v3/api-docs|swagger-ui) {
        return 404;
    }

    # Ingreso: ritmo limitado ademas del limite por direccion de la aplicacion.
    location = /api/v1/auth/login {
        limit_req zone=sarc_login burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # Frontend Angular: archivos estaticos de la version publicada, con respaldo a index.html.
    root /opt/sarc/current/frontend;
    index index.html;
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    }
}
