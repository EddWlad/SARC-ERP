# Copiar a .env (ignorado por Git) y ajustar valores.
POSTGRES_PASSWORD=change-me
# Admin inicial: solo se crea si la base no tiene usuarios. Entra con clave temporal.
SARC_BOOTSTRAP_ADMIN_EMAIL=admin@sarc.local
SARC_BOOTSTRAP_ADMIN_PASSWORD=change-me-12-chars-min

# Cloudinary: imagenes de equipos (opcional en desarrollo)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
