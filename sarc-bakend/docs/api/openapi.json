{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "SARC API",
    "description" : "Sistema Administrativo de Reportes de Carga",
    "version" : "v1"
  },
  "paths" : {
    "/api/v1/users" : {
      "get" : {
        "tags" : [ "user-controller" ],
        "operationId" : "list",
        "parameters" : [ {
          "name" : "text",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "string",
            "maxLength" : 100,
            "minLength" : 0
          }
        }, {
          "name" : "role",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "string",
            "enum" : [ "ADMINISTRADOR", "GERENTE", "SUPERVISOR", "ASISTENTE", "ANALISTA" ]
          }
        }, {
          "name" : "status",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "string",
            "enum" : [ "ACTIVE", "INACTIVE" ]
          }
        }, {
          "name" : "page",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 0,
            "minimum" : 0
          }
        }, {
          "name" : "size",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 20,
            "maximum" : 100,
            "minimum" : 1
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PageResultUserResponse"
                }
              }
            }
          }
        }
      },
      "post" : {
        "tags" : [ "user-controller" ],
        "operationId" : "create",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CreateUserRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CreatedUserResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/{id}/reset-password" : {
      "post" : {
        "tags" : [ "user-controller" ],
        "operationId" : "resetPassword",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TemporaryPasswordResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/password/change" : {
      "post" : {
        "tags" : [ "auth-controller" ],
        "operationId" : "changePassword",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ChangePasswordRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        }
      }
    },
    "/api/v1/auth/login" : {
      "post" : {
        "tags" : [ "auth-controller" ],
        "operationId" : "login",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LoginRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CurrentUserResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/{id}" : {
      "patch" : {
        "tags" : [ "user-controller" ],
        "operationId" : "update",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/UpdateUserRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/UserResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/me" : {
      "get" : {
        "tags" : [ "auth-controller" ],
        "operationId" : "me",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CurrentUserResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "CreateUserRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "maxLength" : 254,
            "minLength" : 0
          },
          "fullName" : {
            "type" : "string",
            "maxLength" : 150,
            "minLength" : 0
          },
          "roles" : {
            "type" : "array",
            "items" : {
              "type" : "string",
              "enum" : [ "ADMINISTRADOR", "GERENTE", "SUPERVISOR", "ASISTENTE", "ANALISTA" ]
            },
            "minItems" : 1,
            "uniqueItems" : true
          }
        },
        "required" : [ "email", "fullName", "roles" ]
      },
      "CreatedUserResponse" : {
        "type" : "object",
        "properties" : {
          "user" : {
            "$ref" : "#/components/schemas/UserResponse"
          },
          "temporaryPassword" : {
            "type" : "string"
          }
        },
        "required" : [ "temporaryPassword", "user" ]
      },
      "UserResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "email" : {
            "type" : "string"
          },
          "fullName" : {
            "type" : "string"
          },
          "roles" : {
            "type" : "array",
            "items" : {
              "type" : "string",
              "enum" : [ "ADMINISTRADOR", "GERENTE", "SUPERVISOR", "ASISTENTE", "ANALISTA" ]
            },
            "uniqueItems" : true
          },
          "status" : {
            "type" : "string",
            "enum" : [ "ACTIVE", "INACTIVE" ]
          },
          "mustChangePassword" : {
            "type" : "boolean"
          },
          "lockedUntil" : {
            "type" : [ "string", "null" ],
            "format" : "date-time"
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "updatedAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "version" : {
            "type" : "integer",
            "format" : "int64"
          }
        },
        "required" : [ "createdAt", "email", "fullName", "id", "mustChangePassword", "roles", "status", "updatedAt", "version" ]
      },
      "TemporaryPasswordResponse" : {
        "type" : "object",
        "properties" : {
          "temporaryPassword" : {
            "type" : "string"
          }
        },
        "required" : [ "temporaryPassword" ]
      },
      "ChangePasswordRequest" : {
        "type" : "object",
        "properties" : {
          "currentPassword" : {
            "type" : "string",
            "minLength" : 1
          },
          "newPassword" : {
            "type" : "string",
            "minLength" : 1
          }
        },
        "required" : [ "currentPassword", "newPassword" ]
      },
      "LoginRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "minLength" : 1
          },
          "password" : {
            "type" : "string",
            "minLength" : 1
          }
        },
        "required" : [ "email", "password" ]
      },
      "CurrentUserResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "email" : {
            "type" : "string"
          },
          "fullName" : {
            "type" : "string"
          },
          "roles" : {
            "type" : "array",
            "items" : {
              "type" : "string",
              "enum" : [ "ADMINISTRADOR", "GERENTE", "SUPERVISOR", "ASISTENTE", "ANALISTA" ]
            },
            "uniqueItems" : true
          },
          "mustChangePassword" : {
            "type" : "boolean"
          }
        },
        "required" : [ "email", "fullName", "id", "mustChangePassword", "roles" ]
      },
      "UpdateUserRequest" : {
        "type" : "object",
        "properties" : {
          "version" : {
            "type" : "integer",
            "format" : "int64"
          },
          "fullName" : {
            "type" : "string",
            "maxLength" : 150,
            "minLength" : 1
          },
          "roles" : {
            "type" : "array",
            "items" : {
              "type" : "string",
              "enum" : [ "ADMINISTRADOR", "GERENTE", "SUPERVISOR", "ASISTENTE", "ANALISTA" ]
            },
            "uniqueItems" : true
          },
          "status" : {
            "type" : "string",
            "enum" : [ "ACTIVE", "INACTIVE" ]
          }
        },
        "required" : [ "version" ]
      },
      "PageResultUserResponse" : {
        "type" : "object",
        "properties" : {
          "content" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/UserResponse"
            }
          },
          "page" : {
            "type" : "integer",
            "format" : "int32"
          },
          "size" : {
            "type" : "integer",
            "format" : "int32"
          },
          "totalElements" : {
            "type" : "integer",
            "format" : "int64"
          },
          "totalPages" : {
            "type" : "integer",
            "format" : "int32"
          }
        },
        "required" : [ "content", "page", "size", "totalElements", "totalPages" ]
      }
    }
  }
}
